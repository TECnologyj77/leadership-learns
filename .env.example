# Analytics is opt-in and remains disabled unless every value below is set for a production build.
VITE_POSTHOG_ENABLED=false

# Use only the public project token from the dedicated Leadership Learners PostHog project.
VITE_POSTHOG_PROJECT_TOKEN=

# Set the ingestion host supplied by that PostHog project (for example, its US or EU cloud host).
VITE_POSTHOG_HOST=

# Set only the exact production hostname. Subdomains, staging, and deploy previews will not match.
VITE_POSTHOG_ALLOWED_HOST=
