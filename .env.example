# Copy to .env.local (ignored by git) for local development.
#
# Wix headless Client ID for anonymous visitor OAuth (Read Blog). Used only by
# server code: the Netlify blog functions and the Vite dev-server blog routes.
# In Netlify, set it under Site configuration > Environment variables with the
# Functions scope; variables in netlify.toml are not visible to functions.
# No Client Secret, API key or admin token is needed or allowed here.
WIX_HEADLESS_CLIENT_ID=

# Optional PostHog analytics (see src/lib/analytics.ts).
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
VITE_POSTHOG_ENABLED=
